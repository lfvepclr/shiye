# 本地部署环境变量（示例）
# 复制为 deploy/local.env 并填真实值。local.env 已在 .gitignore 中，不会入库。
# 用法：set -a; . deploy/local.env; set +a

# 目标主机（IP 或域名）
SHIYE_HOST="<HOST>"
SHIYE_SSH_USER="root"
SHIYE_SSH_PORT="22"

# 站点域名（Caddy 自动签发证书用）
SHIYE_DOMAIN="<HOST>"

# 目标架构，用于交叉编译：x86_64 或 aarch64
SHIYE_ARCH="x86_64"

# 百度智能云
BAIDU_API_KEY="…"
BAIDU_SECRET_KEY="…"
